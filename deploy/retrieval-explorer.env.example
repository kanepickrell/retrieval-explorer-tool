# Chime-in + engine settings for running retrieval-explorer inside the Agent Hub stack.
# Copy the lines you need into agenthub-chime-in/.env before launching with the override
# (deploy/agenthub-stack.yaml). All have sensible defaults in that override.

# Which corpus Ping explores through the Open WebUI chime-in.
CHIME_DATASET=agenthub-export-2026-11-10-latency
CHIME_TECHNIQUE=bm25_vector
# Retrieval engine behind chime-in: "ping" (full hypothesis-driven Ping cycle, per-chat) or
# "assist" (one-shot rewrite -> retrieve -> score -> judge).
CHIME_ENGINE=ping

# Link template for every surfaced doc -> retrieval-explorer's doc page. The engine image
# serves its own UI on this host port, so this just works once the service is up. Leave
# empty to fall back to the generated brief attachment instead.
CHIME_DOC_URL=http://localhost:5180/doc?dataset={dataset}&doc={doc}

# The remote Ollama GPU host the engine uses. NOT host.docker.internal: Ollama runs on a
# separate box, not the machine hosting the containers.
PROTOGRAPH_EMBED_HOST=http://10.128.241.200:11434
PROTOGRAPH_LLM=gemma3:12b
PROTOGRAPH_JUDGE_LLM=gpt-oss:20b

# Host port the engine image (UI + API on one port) is published on. Match CHIME_DOC_URL.
RETRIEVAL_EXPLORER_PORT=5180
